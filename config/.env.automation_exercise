# .env.example
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and should never be committed.

# Application URL (change if testing a staging environment)
BASE_URL=https://www.automationexercise.com

# Pre-registered test user credentials (must exist in the app)
AE_TEST_EMAIL=test_automation@yopmail.com
AE_TEST_PASSWORD=Test123

# Browser settings
HEADLESS=true      # Set to 'false' to watch tests run in a visible browser window
SLOW_MO=0          # Slow motion delay in ms between actions (e.g. 500 to slow down)

# Reporting
SCREENSHOT_ON_FAILURE=true
